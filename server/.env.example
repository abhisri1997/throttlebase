# ── Server ────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
# Any standard Postgres connection string. Nothing in this codebase depends
# on a particular host: PostGIS is the only requirement.
#
# The API connects as the least-privilege role, which owns no tables and has
# no BYPASSRLS, so row-level security actually applies to it.
DATABASE_URL=postgresql://throttlebase_app:password@host:5432/throttlebase

# Used only by `npm run migrate`. A privileged role, because migrations create
# roles, grants and policies that the app role deliberately cannot.
MIGRATION_DATABASE_URL=postgresql://throttlebase_migrator:password@host:5432/throttlebase

# ── Auth: token signing ───────────────────────────────────────────────────
# ES256 key pair. Generate with:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 \
#     -out es256-private.pem
#   openssl pkey -in es256-private.pem -pubout -out es256-public.pem
#   base64 -i es256-private.pem | tr -d '\n'     # the value below
#
# A raw PEM works too; base64 avoids dashboards mangling multi-line values.
# SEC1 keys ("BEGIN EC PRIVATE KEY", what `openssl ecparam -genkey` emits)
# are accepted and converted automatically.
AUTH_JWT_PRIVATE_KEY=
# Any stable identifier, e.g. tb-202609-a1b2c3d4. Published in the JWKS so a
# verifier can pick the right key.
AUTH_JWT_KID=

AUTH_JWT_ISSUER=https://api.throttlebase.in
AUTH_JWT_AUDIENCE=throttlebase-app

# Public keys retired from signing but still published, so tokens issued
# before a rotation keep verifying until they expire. Format: kid:base64pem,
# comma separated. Leave empty when not rotating.
AUTH_JWT_RETIRED_PUBLIC_KEYS=

# ── Auth: identity providers ──────────────────────────────────────────────
# Every OAuth client that may legitimately mint a token for us. List all of
# them: Google's iOS and Android SDKs disagree about whether `aud` is the web
# client or the platform client, and the failure shows up on one platform only.
GOOGLE_CLIENT_IDS=
# Our bundle identifier(s).
APPLE_CLIENT_IDS=in.throttlebase.rider

# ── Auth: policy ──────────────────────────────────────────────────────────
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_CODE_LENGTH=6
AUTH_REFRESH_TOKEN_BYTES=32

# Rate limits. Per-address rules stop one inbox being spammed; per-IP rules
# stop one caller working through many addresses.
AUTH_OTP_START_PER_EMAIL_LIMIT=3
AUTH_OTP_START_PER_EMAIL_WINDOW=900
AUTH_OTP_START_PER_EMAIL_DAILY_LIMIT=10
AUTH_OTP_START_PER_EMAIL_DAILY_WINDOW=86400
AUTH_OTP_START_PER_IP_LIMIT=30
AUTH_OTP_START_PER_IP_WINDOW=900
AUTH_OTP_VERIFY_PER_IP_LIMIT=30
AUTH_OTP_VERIFY_PER_IP_WINDOW=900

# ── Consent ───────────────────────────────────────────────────────────────
# The client echoes the version it displayed; a mismatch refuses account
# creation. Bump these when the documents change.
TERMS_VERSION=2026-01-01
PRIVACY_VERSION=2026-01-01

# ── Email ─────────────────────────────────────────────────────────────────
# console | smtp. Defaults to console.
#
# console prints codes to the log instead of sending them, which is all a
# developer needs. It is REFUSED in production unless ALLOW_CONSOLE_EMAIL=true,
# because it fails silently: everything looks healthy while no rider can sign
# in. An unrecognised driver stops the boot rather than falling back.
EMAIL_DRIVER=console
# ALLOW_CONSOLE_EMAIL=true

MAIL_FROM="ThrottleBase <no-reply@mail.throttlebase.in>"
MAIL_REPLY_TO=support@throttlebase.in

# Required when EMAIL_DRIVER=smtp; boot fails if any is missing.
# Port 465 with SMTP_SECURE=true is implicit TLS; 587 with false is STARTTLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── CORS / docs ───────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://throttlebase.in,https://www.throttlebase.in
ENABLE_SWAGGER_DOCS=false
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=change_me

# ── Third-party ───────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# Hard ceiling on outbound Google Places calls per day. Once exceeded the
# server stops calling Google entirely and returns degraded responses, so a
# runaway loop cannot produce a runaway bill.
MAX_DAILY_PLACES_CALLS=500
