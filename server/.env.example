PORT=5001
NODE_ENV=production
DATABASE_URL=postgresql://username:password@host:port/database_name
# Use a Neon connection string or any Postgres connection URL.
# If using DATABASE_URL, DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME are optional.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=throttle_base

JWT_SECRET=replace_with_a_strong_random_secret
CORS_ALLOWED_ORIGINS=https://throttlebase.in,https://www.throttlebase.in
ENABLE_SWAGGER_DOCS=false
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=strongpassword
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
