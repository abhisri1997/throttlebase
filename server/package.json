{
  "name": "throttlebase-server",
  "version": "1.0.0",
  "description": "Backend API for ThrottleBase",
  "main": "index.js",
  "scripts": {
    "test": "tsx test.ts",
    "test:live-health": "tsx test.ts",
    "start": "tsx src/app.ts",
    "dev": "nodemon --exec tsx src/app.ts",
    "worker": "tsx src/workers/worker.ts",
    "dev:all": "concurrently --names api,worker \"npm run dev\" \"npm run worker\"",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "lint:boundaries": "eslint . --config eslint.boundaries.config.js --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/adapters/postgres/migrate.ts",
    "migrate:prod": "NODE_ENV=production tsx src/adapters/postgres/migrate.ts",
    "migrate:dev": "NODE_ENV=development tsx src/adapters/postgres/migrate.ts",
    "migrate:dry-run": "tsx src/adapters/postgres/migrate.ts --dry-run",
    "routes:name-ends": "tsx src/adapters/postgres/nameRouteEnds.ts",
    "migrate:baseline": "tsx src/adapters/postgres/migrate.ts --baseline-existing",
    "test:integration": "tsx --test --test-concurrency=1 \"src/adapters/postgres/*.integration.test.ts\"",
    "rides:recompute-riding": "tsx src/adapters/postgres/recomputeRiding.ts",
    "sealed:keygen": "tsx src/adapters/postgres/sealedRecordsCli.ts keygen",
    "sealed:open": "tsx src/adapters/postgres/sealedRecordsCli.ts open",
    "sealed:hold": "tsx src/adapters/postgres/sealedRecordsCli.ts hold",
    "sealed:release": "tsx src/adapters/postgres/sealedRecordsCli.ts release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.3.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.18.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
