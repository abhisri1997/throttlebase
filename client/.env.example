EXPO_PUBLIC_API_URL=https://api.throttlebase.in
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# Native map RENDERING only, read by app.config.ts at build time. These keys are
# restricted to the Maps SDKs and reject REST calls, so they are not usable for
# Directions, Geocoding or Places.
#
# There is deliberately no Google key for JS here: Directions, Geocoding and
# Places all go through the backend at /api/maps/*, which holds the key server
# side. EXPO_PUBLIC_GOOGLE_MAPS_API_KEY and EXPO_PUBLIC_GOOGLE_PLACES_API_KEY
# were removed for that reason — do not reintroduce them.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
